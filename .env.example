# Copiar a .env para desarrollo local (nunca commitear .env)

# PostgreSQL
POSTGRES_DB=calishome
POSTGRES_USER=calishome
POSTGRES_PASSWORD=calishome_dev_change_me
POSTGRES_PORT=5432

# Backend Spring Boot (dev | test | prod)
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/calishome
DB_USERNAME=calishome
DB_PASSWORD=calishome_dev_change_me

# Auth & JWT (en prod usar secreto aleatorio >= 32 bytes)
JWT_SECRET=dev-only-calishome-secret-key-at-least-32-bytes-long-2026
JWT_ISSUER=calishome-api
COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# Email SMTP (en Docker dev usa mailpit:1025 por defecto; requerido SMTP real en prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@calishome.app
MAILPIT_UI_PORT=8026

# Web Push VAPID (requerido en prod; en dev/test se genera en memoria si se dejan vacíos)
VAPID_SUBJECT=mailto:soporte@calishome.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Seguridad HTTP, CORS y Rate Limiting
TRUST_FORWARDED_HEADERS=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GLOBAL_RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_RPM=120

# Monetizacion / Wompi (dejar llaves vacias en dev para usar Sandbox $0)
BILLING_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
BILLING_SANDBOX_ENABLED=true

# Frontend
FRONTEND_PORT=5173
VITE_GOOGLE_CLIENT_ID=
