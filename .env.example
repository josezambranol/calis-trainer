# Copiar a .env para desarrollo local (nunca commitear .env)

# PostgreSQL
POSTGRES_DB=calishome
POSTGRES_USER=calishome
POSTGRES_PASSWORD=calishome_dev_change_me
POSTGRES_PORT=5432

# Backend Spring Boot (dev | test | prod)
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/calishome
DB_USERNAME=calishome
DB_PASSWORD=calishome_dev_change_me

# Auth & JWT (en prod usar secreto aleatorio >= 32 bytes)
JWT_SECRET=dev-only-calishome-secret-key-at-least-32-bytes-long-2026
JWT_ISSUER=calishome-api
COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173

# Email SMTP (requerido en prod)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Frontend
FRONTEND_PORT=5173
VITE_GOOGLE_CLIENT_ID=
